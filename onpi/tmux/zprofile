#!/bin/zsh

# We store the ssh connection multiplexer sockets in this directory.
mkdir /tmp/ssh

# This setup is designed so that you can "use tmux as your shell" but still
# preserve support for rsync and scp. Instead we set zsh as our shell and have
# the following .zprofile file which starts tmux if it's an interactive session.
#
# How does this tmux setup work?
#  * There is one "default" session called default.
#  * When you connect you clone the "default" session (your session joins its
#    session group; tmux names it after its session id, "default-4" on tmux
#    3.x or "4" on older tmux, and I refer to them as "unnamed sessions") and
#    a new window is created.
#  * These "unnamed sessions" are reaped after they no longer have real
#    terminals connected to them.
#  * The "default" session has help listed on window 0. This stops this session
#    from exiting even after all other windows are closed.
#
# This means that all sessions will have the same windows in them.
#
# If I want to keep a session around (because I have a nice tiled setup or
# something) rename the session from the name tmux gave it to something human
# usable.

if tmux -V; then
	echo "tmux found!"
else
	exec bash -l
fi

# Environment variables to update.
UPDATE_ENV="DISPLAY SSH_ASKPATH SSH_AUTH_SOCK SSH_AGENT_PID SSH_CONNECTION WINDOWID XAUTHORITY XDG_SESSION_COOKIE DBUS_SESSION_BUS_ADDRESS GNOME_KEYRING_CONTROL GNOME_KEYRING_PID GNOME_KEYRING_SOCKET ORBIT_SOCKETDIR KRB5CCNAME SSH_AGENT_PID SESSION_MANAGER"
# File to save them too
ENVFILE="$HOME/.update-env"

# Dump them into a form which can be used
echo > $ENVFILE
for env in `echo $UPDATE_ENV`; do
	if [ x"${(P)env}" = x ]; then
		echo "unset $env" >> $ENVFILE
	else
		echo "export $env=\"${(P)env}\"" >> $ENVFILE
	fi
done

if [[ ( -z "$STY" ) && (( ! -z "$SSH_CONNECTION" ) || ( x"$TERM" == x"xterm-256color" ) || ( x"$TERM" == x"xterm" ) || ( x"$TERM" == x"linux" )) ]]; then
	if ! tmux has-session -t '=default' >/dev/null 2>&1; then
		# Create the default session that all our windows will be in. If it
		# was killed or renamed while its group lives on, re-create it in
		# that group, so it has the group's windows again. Quietly: two
		# logins racing here make one "duplicate session". The member is a
		# session id ($N); list-sessions' errors (no server yet after boot)
		# do not match that and are dropped.
		default_member=
		for line in ${(f)"$(tmux list-sessions -F '#{session_id}' -f '#{==:#{session_group},default}' 2>&1)"}; do
			if [[ $line == '$'<-> ]]; then
				default_member=$line
				break
			fi
		done
		if [[ -n $default_member ]]; then
			tmux new-session -d -s default -t "$default_member" >/dev/null 2>&1
		else
			tmux new-session -d -s default -n h "tail -f ~/.tmux-help" \; setw remain-on-exit\; send-keys C-c >/dev/null 2>&1
		fi
	fi
	# Reap any unnamed sessions which don't have anything attached: sessions in
	# the group of "default" (other than "default" itself) with no client.
	# tmux names a login's session after its session id ($4 is "default-4" on
	# tmux 3.x, "4" on older tmux); a session renamed to anything else is kept.
	# Reap only while the session default itself is in that group (if it was
	# killed or renamed, the login sessions hold the group's windows), and never
	# a session holding a window no other session has: reaping closes no window.
	if [[ "$(tmux display-message -p -t '=default:' '#{session_group}')" == default ]]; then
		for reap in ${(f)"$(tmux list-sessions -F '#{session_id} #{session_name}' -f '#{&&:#{==:#{session_group},default},#{&&:#{!=:#{session_name},default},#{==:#{session_attached},0}}}')"}; do
			reap_id=${reap%% *}
			reap_name=${reap#* }
			[[ $reap_id == '$'<-> && ( $reap_name == "default-${reap_id#?}" || $reap_name == "${reap_id#?}" ) ]] || continue
			# One line per window, listing the sessions it is in (a session
			# twice if the window is linked into it twice): a line naming only
			# this session is a window no other session has. An error (another
			# login reaped the session first) names no session.
			reap_keep=
			for reap_window in ${(f)"$(tmux list-windows -t "$reap_id" -F '#{window_linked_sessions_list}' 2>&1)"}; do
				if [[ ${(j:,:)${(u)${(s:,:)reap_window}}} == "$reap_name" ]]; then
					reap_keep=1
					break
				fi
			done
			[[ -n $reap_keep ]] && continue
			# Check that nobody attached and kill in one server command, so a
			# client attaching in between is not detached; quietly, as a racing
			# login may have reaped it already. A suspended client (C-z) counts
			# as not attached, as it did before: its session is reaped, while
			# its windows live on in the group.
			tmux if-shell -F -t "$reap_id" '#{==:#{session_attached},0}' "kill-session -t '$reap_id'" >/dev/null 2>&1
		done
	fi
	# Join the group of default and start a new window: the login would
	# otherwise land on the group's first window, the help window h, whose
	# pane is dead (send-keys C-c above ended its tail).
	exec tmux new-session -t default \; new-window
else
        echo "Not starting tmux!"
	echo "STY='$STY' SSH_CONNECTION='$SSH_CONNECTION' TERM='$TERM'"
fi
